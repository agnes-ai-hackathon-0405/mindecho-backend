# Put this file next to `requirements.txt` (repo root) and copy to `.env`.
# Loading uses that path explicitly so uvicorn works from any working directory.

# =============================================================================
# Mixed stack: Mify (speech) + Volcengine direct (video / optional IAM)
# =============================================================================
#
# - TTS + ASR: Mify only — MIFY_API_KEY, X-Model-Provider-Id, model/voice strings.
#   Volcengine speech products here are reached *through* Mify, not with VOLC_* keys.
#
# - Video + IAM probe: Volcengine SDK — VOLC_ACCESSKEY / VOLC_SECRETKEY to the API
#   (visual + iam), same as volc-sdk-python.
# =============================================================================

# --- Mify (required for /tts, /transcribe, /video/from-voice ASR step) ---
MIFY_API_KEY=your_key_here
# MIFY_BASE_URL=http://model.mify.ai.srv

# Model IDs must match your Mify deployment (see "Not supported model string" if wrong).
# TTS (provider header default: xiaomi — override with MIFY_PROVIDER_ID if needed).
# If you see "Not supported model string", GET /config/mify then align with Mify’s catalog.
# DEFAULT_MODEL=tts-multivoice-v1
# DEFAULT_VOICE=zh_male_guanlan_prem
# ASR (provider default volcengine_maas — Volc ASR *via* Mify, not direct VOLC_*):
# ASR_PROVIDER_ID=volcengine_maas
# DEFAULT_ASR_MODEL=volc.bigasr.auc_turbo

# --- Volcengine direct (Jimeng 3.0 Pro — POST /video/from-text, /video/from-voice; /volc/iam/probe) ---
# Doc: https://www.volcengine.com/docs/85621/1777001?lang=zh
VOLC_ACCESSKEY=
VOLC_SECRETKEY=
# VOLC_JIMENG_REQ_KEY=jimeng_ti2v_v30_pro
